{% extends 'base.html.twig' %}

{% block title %}Most Starred PHP Projects{% endblock %}

{% block body %}
<div class="container my-5">

  <div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-dark text-white p-4 d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 rounded">
      <h1 class="h3 mb-0">Most Starred Public PHP Projects</h1>
      <!-- Styled Primary Action Button -->
      <div>
        <a href="{{ path('refresh_github_projects') }}" class="btn btn-warning text-dark fw-bold btn-sm px-4 py-2">
          Refresh from GitHub
        </a>
      </div>
    </div>
  </div>

  {% for label, messages in app.flashes %}
    {% for message in messages %}
      <div class="alert {{ label == 'error' or label == 'danger' ? 'alert-danger' : 'alert-success' }} shadow-sm mb-4" role="alert">
        <strong>{{ label == 'error' or label == 'danger' ? 'Error:' : 'Success:' }}</strong> {{ message }}
      </div>
    {% endfor %}
  {% endfor %}

    <div class="table-responsive border rounded shadow-sm bg-white">
      <table id="projects-table" class="display table table-hover table-striped align-middle mb-0">
        <thead class="table-light border-bottom">
          <tr>
            <th scope="col" class="ps-3 text-muted text-uppercase small tracking-wider" style="width: 10%;">#</th>
            <th scope="col" class="text-muted text-uppercase small tracking-wider" style="width: 65%;">Project Name</th>
            <th scope="col" class="pe-3 text-muted text-uppercase small tracking-wider" style="width: 25%;">Stars</th>
          </tr>
        </thead>
        <tbody>
        <!-- Empty! DataTables will inject rows here via AJAX -->
        </tbody>
      </table>
    </div>
</div>
{% endblock %}
