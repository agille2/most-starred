{% extends 'base.html.twig' %}

{% block title %}Most Starred PHP Projects{% endblock %}

{% block body %}
    <h1>Most Starred Public PHP Projects</h1>

    <p>
        <a href="{{ path('refresh_github_projects') }}" class="btn btn-primary">Refresh from GitHub</a>
    </p>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert {{ label == 'error' ? 'alert-danger' : 'alert-success' }}" role="alert">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    {% if repositories is empty %}
        <p>No GitHub repository data is currently stored. Click "Refresh from GitHub" to load the latest data.</p>
    {% else %}
        <table id="projects-table" class="display table table-striped table-hover table-bordered">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th>Stars</th>
                </tr>
            </thead>
            <tbody>
                {% for repo in repositories %}
                    <tr>
                        <td>{{ loop.index }}</td>
                        <td><a href="{{ path('project_show', {'id': repo.repoId}) }}">{{ repo.name }}</a></td>
                        <td>{{ repo.stars }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
