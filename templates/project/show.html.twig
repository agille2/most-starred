{% extends 'base.html.twig' %}

{% block title %}Project Details - {{ repo.name }}{% endblock %}

{% block body %}

<div class="container my-5" style="max-width: 750px;">

  <div class="mb-4">
    <a href="{{ path('index') }}" class="btn btn-outline-secondary btn-sm px-3">
      &larr; Back to list
    </a>
  </div>

  <div class="card shadow-sm border-0">
    
    <div class="card-header bg-dark text-white p-4 d-flex justify-content-between align-items-center rounded-top">
      <h1 class="h3 mb-0">Project Details</h1>
      <span class="badge bg-warning text-dark px-3 py-2 fs-6 fw-bold font-monospace">
        {{ repo.stars }} Stars
      </span>
    </div>
  
    <div class="card-body p-4">

      <div class="mb-4">
        <label class="text-uppercase tracking-wider small text-muted d-block mb-1">Repository Name</label>
        <h2 class="h4 card-title mb-0">
          <a href="{{ repo.url }}" target="_blank" rel="noreferrer" class="text-decoration-none fw-bold">
            {{ repo.name }} <small class="text-muted fs-6 font-weight-normal">&nearr;</small>
          </a>
        </h2>
      </div>
 
      <div class="mb-4 bg-light p-3 rounded">
        <label class="text-uppercase tracking-wider small text-muted d-block mb-2">Description</label>
        <p class="card-text text-secondary mb-0 lead fs-6">
          {{ repo.description ?: 'No description provided for this repository.' }}
        </p>
      </div>

      <div class="row g-3 border-top pt-4 mt-2">
        <div class="col-12 col-sm-6">
          <span class="text-uppercase tracking-wider small text-muted d-block mb-1">Created On</span>
          <span class="font-monospace text-dark d-block">
            {{ repo.createdDate ? repo.createdDate|date('Y-m-d H:i') : 'N/A' }}
          </span>
        </div>
        <div class="col-12 col-sm-6">
          <span class="text-uppercase tracking-wider small text-muted d-block mb-1">Last Code Push</span>
          <span class="font-monospace text-dark d-block">
            {{ repo.lastPushDate ? repo.lastPushDate|date('Y-m-d H:i') : 'N/A' }}
          </span>
        </div>
      </div>

    </div>
  </div>
</div>
{% endblock %}
